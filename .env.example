# ---- Supabase (owner wires in) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Stripe (owner wires in) ----
VITE_STRIPE_PUBLISHABLE_KEY=

# ---- Generation backend (server-only — set these in Vercel, not locally exposed) ----
# Read by api/generate.js, api/generate-status.js, and api/health.js. These
# must NOT be prefixed with VITE_ — that prefix ships a var to the browser
# bundle, which would leak the secret to every visitor.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# Optional: point the frontend at a fully separate generation backend instead
# of this repo's own /api routes (same {jobId}/{status} contract required).
VITE_GENERATION_API_URL=

# Optional: base URL for serving generated media (CDN/bucket)
VITE_MEDIA_BASE_URL=
