# ---- Supabase (owner wires in) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Stripe (owner wires in) ----
VITE_STRIPE_PUBLISHABLE_KEY=

# ---- Generation backend ----
# The media-generation API (Higgsfield / Gemini) is called server-side by the
# owner's backend. The frontend only talks to this endpoint; never expose keys.
VITE_GENERATION_API_URL=

# Optional: base URL for serving generated media (CDN/bucket)
VITE_MEDIA_BASE_URL=
